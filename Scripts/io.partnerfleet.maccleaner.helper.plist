<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchDaemon for the root helper, registered via SMAppService.daemon().
     Ships inside the main app bundle at Contents/Library/LaunchDaemons/.
     BundleProgram is relative to the app bundle's Contents/. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.partnerfleet.maccleaner.helper</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/MacCleanerHelper</string>
    <key>MachServices</key>
    <dict>
        <key>io.partnerfleet.maccleaner.helper</key>
        <true/>
    </dict>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>io.partnerfleet.maccleaner</string>
    </array>
</dict>
</plist>
